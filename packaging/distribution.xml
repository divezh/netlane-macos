<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Netlane</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="13.0"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Netlane">
        <pkg-ref id="io.github.divezh.netlane"/>
    </choice>
    <pkg-ref id="io.github.divezh.netlane" version="@VERSION@" onConclusion="none">Netlane-component.pkg</pkg-ref>
</installer-gui-script>
