+// Netlane's application routing cannot infer an application from a shared DNS resolver.
+// The opt-in flag must override domain exclusions for both UDP and TCP queries.
+class NetlaneDnsAllThroughVpn : public DnsRoutingAllProxies,
+                                public testing::WithParamInterface<std::tuple<bool, VpnMode, int>> {};
+
+TEST_P(NetlaneDnsAllThroughVpn, OverridesDomainExclusions) {
+    auto [enabled, mode, protocol] = GetParam();
+    vpn.listener_config.dns_all_through_upstreams = enabled;
+    ASSERT_TRUE(vpn.tunnel->update_dns_handler_parameters());
+    vpn.update_exclusions(mode, mode == VPN_MODE_GENERAL ? "example.org" : "");
+    TunnelAddress dst = SocketAddress("8.8.8.8:53");
+    SocketAddress src("127.0.0.1:50001");
+    ClientConnectRequest event{
+            .id = vpn.listener_conn_id_generator.get(),
+            .protocol = protocol,
+            .src = &src,
+            .dst = &dst,
+            .app_name = "TestAppName",
+    };
+    ASSERT_NO_FATAL_FAILURE(raise_and_complete(event));
+    auto &expected_server = enabled ? user_server : system_server;
+    expected_server->expect({
+            .request =
+                    MockDnsServer::Request{
+                            .tcp = protocol == IPPROTO_TCP, .qtype = LDNS_RR_TYPE_A, .qname = "example.org."},
+            .response = MockDnsServer::Response{.rcode = LDNS_RCODE_REFUSED},
+    });
+    ASSERT_NO_FATAL_FAILURE(accept_and_send(event, "example.org.", LDNS_RR_TYPE_A));
+    vpn_event_loop_exit(ev_loop.get(), DEFAULT_TIMEOUT);
+    vpn_event_loop_run(ev_loop.get());
+    vpn_event_loop_finalize_exit(ev_loop.get());
+    EXPECT_EQ(enabled ? 1 : 0, user_complete);
+    EXPECT_EQ(enabled ? 0 : 1, system_complete);
+    EXPECT_EQ(0, user_unexpected);
+    EXPECT_EQ(0, system_unexpected);
+    EXPECT_EQ(0, system_ipv6_unexpected);
+}
+
+INSTANTIATE_TEST_SUITE_P(Netlane, NetlaneDnsAllThroughVpn,
+        testing::Combine(testing::Bool(), testing::Values(VPN_MODE_GENERAL, VPN_MODE_SELECTIVE),
+                testing::Values(IPPROTO_UDP, IPPROTO_TCP)));
+
