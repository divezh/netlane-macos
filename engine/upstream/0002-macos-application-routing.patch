+#ifdef __APPLE__
+// libproc lists every process's sockets (the engine runs as root, so it sees all of them): the owner is
+// the process with a TCP socket from this source to this destination, or a UDP socket bound to this
+// source port. The same socket in two processes (inherited) leaves the owner unknown.
+static bool same_address(const in_sockinfo &info, const sockaddr *address, bool local) {
+    if (address->sa_family == AF_INET) {
+        if ((info.insi_vflag & INI_IPV4) == 0) {
+            return false;
+        }
+        const auto *v4 = reinterpret_cast<const sockaddr_in *>(address); // NOLINT(cppcoreguidelines-pro-type-reinterpret-cast)
+        const in_addr &mine = local ? info.insi_laddr.ina_46.i46a_addr4 : info.insi_faddr.ina_46.i46a_addr4;
+        int port = local ? info.insi_lport : info.insi_fport;
+        return static_cast<uint16_t>(port) == v4->sin_port
+                && (mine.s_addr == v4->sin_addr.s_addr || (local && mine.s_addr == INADDR_ANY));
+    }
+    if ((info.insi_vflag & INI_IPV6) == 0) {
+        return false;
+    }
+    const auto *v6 = reinterpret_cast<const sockaddr_in6 *>(address); // NOLINT(cppcoreguidelines-pro-type-reinterpret-cast)
+    const in6_addr &mine = local ? info.insi_laddr.ina_6 : info.insi_faddr.ina_6;
+    int port = local ? info.insi_lport : info.insi_fport;
+    static constexpr in6_addr ANY = IN6ADDR_ANY_INIT;
+    return static_cast<uint16_t>(port) == v6->sin6_port
+            && (std::memcmp(&mine, &v6->sin6_addr, sizeof(in6_addr)) == 0
+                    || (local && std::memcmp(&mine, &ANY, sizeof(in6_addr)) == 0));
+}
+
+static std::optional<pid_t> connection_owner(const sockaddr *source, const sockaddr *destination, int protocol) {
+    if (source == nullptr || (source->sa_family != AF_INET && source->sa_family != AF_INET6)
+            || (protocol != IPPROTO_TCP && protocol != IPPROTO_UDP)) {
+        return std::nullopt;
+    }
+    bool tcp = protocol == IPPROTO_TCP;
+    if (destination != nullptr && destination->sa_family != source->sa_family) {
+        destination = nullptr;
+    }
+    int bytes = proc_listpids(PROC_ALL_PIDS, 0, nullptr, 0);
+    if (bytes <= 0) {
+        return std::nullopt;
+    }
+    std::vector<pid_t> pids(static_cast<size_t>(bytes) / sizeof(pid_t) + 64);
+    bytes = proc_listpids(PROC_ALL_PIDS, 0, pids.data(), static_cast<int>(pids.size() * sizeof(pid_t)));
+    if (bytes <= 0) {
+        return std::nullopt;
+    }
+    pids.resize(static_cast<size_t>(bytes) / sizeof(pid_t));
+    pid_t self = getpid();
+    std::optional<pid_t> owner;
+    bool ambiguous = false;
+    std::vector<proc_fdinfo> fds;
+    for (pid_t pid : pids) {
+        if (pid <= 0 || pid == self) {
+            continue;
+        }
+        int size = proc_pidinfo(pid, PROC_PIDLISTFDS, 0, nullptr, 0);
+        if (size <= 0) {
+            continue;
+        }
+        fds.resize(static_cast<size_t>(size) / sizeof(proc_fdinfo) + 16);
+        size = proc_pidinfo(pid, PROC_PIDLISTFDS, 0, fds.data(), static_cast<int>(fds.size() * sizeof(proc_fdinfo)));
+        if (size <= 0) {
+            continue;
+        }
+        size_t count = static_cast<size_t>(size) / sizeof(proc_fdinfo);
+        for (size_t i = 0; i < count; ++i) {
+            if (fds[i].proc_fdtype != PROX_FDTYPE_SOCKET) {
+                continue;
+            }
+            socket_fdinfo info{};
+            if (proc_pidfdinfo(pid, fds[i].proc_fd, PROC_PIDFDSOCKETINFO, &info, sizeof(info)) != sizeof(info)) {
+                continue;
+            }
+            const socket_info &socket = info.psi;
+            if (socket.soi_family != AF_INET && socket.soi_family != AF_INET6) {
+                continue;
+            }
+            bool matches = false;
+            if (tcp && socket.soi_kind == SOCKINFO_TCP) {
+                const in_sockinfo &in = socket.soi_proto.pri_tcp.tcpsi_ini;
+                matches = same_address(in, source, true) && (destination == nullptr || same_address(in, destination, false));
+            } else if (!tcp && socket.soi_kind == SOCKINFO_IN && socket.soi_protocol == IPPROTO_UDP) {
+                matches = same_address(socket.soi_proto.pri_in, source, true);
+            }
+            if (matches) {
+                if (owner && *owner != pid) {
+                    ambiguous = true;
+                }
+                owner = pid;
+            }
+        }
+        if (ambiguous) {
+            return std::nullopt;
+        }
+    }
+    return owner;
+}
+#endif
