+// POSIX socket APIs take sockaddr pointers; the casts are required by the OS.
+// NOLINTBEGIN(cppcoreguidelines-pro-type-reinterpret-cast)
+TEST(ApplicationRoutes, ResolveMacTcpOwnerWithMatchingRemoteEndpoint) {
+    int listener = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    int connection = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    ASSERT_GE(listener, 0);
+    ASSERT_GE(connection, 0);
+    sockaddr_in remote{};
+    remote.sin_family = AF_INET;
+    remote.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    ASSERT_EQ(bind(listener, reinterpret_cast<const sockaddr *>(&remote), sizeof(remote)), 0);
+    ASSERT_EQ(listen(listener, 1), 0);
+    socklen_t length = sizeof(remote);
+    ASSERT_EQ(getsockname(listener, reinterpret_cast<sockaddr *>(&remote), &length), 0);
+    ASSERT_EQ(connect(connection, reinterpret_cast<const sockaddr *>(&remote), sizeof(remote)), 0);
+    sockaddr_in local{};
+    length = sizeof(local);
+    ASSERT_EQ(getsockname(connection, reinterpret_cast<sockaddr *>(&local), &length), 0);
+    auto owner = application_for_connection(
+            reinterpret_cast<const sockaddr *>(&local), reinterpret_cast<const sockaddr *>(&remote), IPPROTO_TCP);
+    sockaddr_in wrong = remote;
+    wrong.sin_port = 0;
+    auto wrong_remote = application_for_connection(
+            reinterpret_cast<const sockaddr *>(&local), reinterpret_cast<const sockaddr *>(&wrong), IPPROTO_TCP);
+    close(connection);
+    close(listener);
+    // The lookup skips the engine's own process, so a test in the same process finds nobody: that is the
+    // point (the engine must never route itself). The child below checks a real owner.
+    EXPECT_FALSE(owner);
+    EXPECT_FALSE(wrong_remote);
+}
