+TEST(ApplicationRoutes, ResolveMacOwnerOfAnotherProcess) {
+    int pipe_fds[2];
+    ASSERT_EQ(pipe(pipe_fds), 0);
+    pid_t child = fork();
+    ASSERT_GE(child, 0);
+    if (child == 0) {
+        close(pipe_fds[0]);
+        int socket = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+        sockaddr_in local{};
+        local.sin_family = AF_INET;
+        local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        bind(socket, reinterpret_cast<const sockaddr *>(&local), sizeof(local));
+        socklen_t length = sizeof(local);
+        getsockname(socket, reinterpret_cast<sockaddr *>(&local), &length);
+        write(pipe_fds[1], &local, sizeof(local));
+        sleep(10);
+        _exit(0);
+    }
+    close(pipe_fds[1]);
+    sockaddr_in local{};
+    ASSERT_EQ(read(pipe_fds[0], &local, sizeof(local)), static_cast<ssize_t>(sizeof(local)));
+    close(pipe_fds[0]);
+    auto owner = application_for_connection(reinterpret_cast<const sockaddr *>(&local), nullptr, IPPROTO_UDP);
+    auto tcp = application_for_connection(reinterpret_cast<const sockaddr *>(&local), nullptr, IPPROTO_TCP);
+    kill(child, SIGKILL);
+    waitpid(child, nullptr, 0);
+    ASSERT_TRUE(owner);
+    EXPECT_NE(owner->find("test_application_routes"), std::string::npos);
+    EXPECT_FALSE(tcp);
+}
